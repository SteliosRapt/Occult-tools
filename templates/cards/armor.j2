{% import "cards/_blocks.j2" as k %}
<article class="card item armor size-{{ c.size }}{% block extension_0 %}{% endblock %}" data-key="{{ c.key }}" data-back="{{ c.back.key }}">
  <header class="c-head">
    <span class="c-emblem" title="Armor">{{ k.ico("ui-shield", "gl") }}</span>
    <div class="c-titles">{{ k.tag("Armor") }}<h2 class="c-title">{{ c.title }}</h2><div class="c-type"><span class="c-type-text">{{ c.type_line }}</span><span class="c-cont-note">continued</span></div></div>
  </header>
  {% block extension_2 %}{% endblock %}
  <div class="c-meta c-item-meta{% block extension_1 %}{% endblock %}">
  <div class="c-item-main">
  <div class="c-hero-row">
  {% block extension_3 %}{% endblock %}
  <div class="c-hero">
    <div class="hero-big"><span class="hero-k">AC</span><span class="hero-n">{{ c.ac }}</span></div>
    <div class="hero-alt">{{ c.ac_note }}</div>
  </div>
  </div>
  <dl class="c-stats c-stats-item">
    <div class="st"><dt>Strength</dt><dd>{{ c.str_req }}</dd></div>
    <div class="st"><dt>Stealth</dt><dd>{{ c.stealth }}</dd></div>
    <div class="st"><dt>Don · Doff</dt><dd>{{ c.don_doff }}</dd></div>
    <div class="st"><dt>Weight · Cost</dt><dd>{{ c.weight }} · {{ c.cost }}</dd></div>
  </dl>
  </div>
  {% block extension_4 %}{% endblock %}
  </div>
  <div class="c-body">
    {% for p in c.rules %}<p class="run"><b class="lab">{{ p.label }}.</b> {{ p.html | safe }}</p>{% endfor %}
  </div>
  {{ k.foot(c, "Armor") }}
</article>
