{% import "cards/_blocks.j2" as k %}
<article class="card item weapon size-{{ c.size }}{% block extension_0 %}{% endblock %}" data-key="{{ c.key }}" data-back="{{ c.back.key }}">
  <header class="c-head">
    <div class="c-titles">{{ k.tag("Weapon") }}<h2 class="c-title">{{ c.title }}</h2><div class="c-type"><span class="c-type-text">{{ c.type_line }}</span><span class="c-cont-note">continued</span></div></div>
  </header>
  {% block extension_2 %}{% endblock %}
  <div class="c-meta c-item-meta{% block extension_1 %}{% endblock %}">
  <div class="c-item-main">
  <div class="c-hero-row">
  {% block extension_3 %}{% endblock %}
  <div class="c-hero">
    <div class="hero-big"><span class="hero-n">{{ c.damage }}</span><span class="hero-u">{{ c.damage_type }}</span></div>
    {% if c.versatile %}<div class="hero-alt"><b>{{ c.versatile }}</b> two-handed</div>{% endif %}
    <div class="hero-alt">{{ {"strength": "Strength", "dexterity": "Dexterity", "finesse": "Str or Dex"}[c.ability] }} attack</div>
  </div>
  </div>
  <dl class="c-stats c-stats-item">
    <div class="st st-wide"><dt>Properties</dt><dd>{{ c.props_short | join(", ") or "—" }}</dd></div>
    <div class="st"><dt>Mastery</dt><dd>{{ c.mastery }}</dd></div>
    <div class="st"><dt>Weight · Cost</dt><dd>{{ c.weight }} · {{ c.cost }}</dd></div>
  </dl>
  </div>
  {% block extension_4 %}{% endblock %}
  </div>
  <div class="c-body">
    <div class="c-upcast c-mastery"><p><b class="lab">Mastery: {{ c.mastery }}.</b> {{ c.mastery_html | safe }}</p></div>
    {% for p in c.props %}<p class="run"{% if p.short %} data-short="{{ p.short }}"{% endif %}><b class="lab">{{ p.label }}.</b> {{ p.html | safe }}</p>{% endfor %}
  </div>
  {{ k.foot(c, "Weapon") }}
</article>
