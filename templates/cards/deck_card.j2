{% import "cards/_blocks.j2" as k %}
{# A deck face and its rules, in tarot format. #}
<article class="card deck-card size-{{ c.size }}{% block face_class %}{% endblock %}" data-key="{{ c.key }}" data-back="{{ c.back.key }}">
  {% block face_image %}{% endblock %}
  <div class="dk-window"></div>
  <div class="dk-panel">
    <header class="c-head">
      <div class="c-titles"><h2 class="c-title">{{ c.title }}</h2><div class="c-type"><span class="c-type-text">{{ c.deck }}</span><span class="c-cont-note">continued</span></div></div>
    </header>
    <div class="c-body">
      {{ k.blocks(c.body) }}
    </div>
    {% block footer %}{{ k.foot(c, c.deck) }}{% endblock %}
  </div>
</article>
