{% extends "book/_base.html.j2" %}
{% import "book/_blocks.j2" as k %}
{% import "book/_spells.j2" as sp %}
{# Class booklet: core traits, the 20-level progression (from data), features in level order,
   the class's option menus and spell list as printed, then the subclasses. A booklet to a level
   to a level stops at that level and includes the spells cast by then in full. #}
{% block book %}
<section class="class-opener">
{{ k.opener(book.kicker, book.title, book.tagline) }}
{# no intro beside it (a subclass booklet with --class-features): the traits box alone, full width, unbroken #}
{% if book.intro or book.traits %}<div class="{{ 'columns-2' if book.intro else 'traits-solo' }} class-intro">
{% for b in book.intro %}<p{% if loop.first %} class="drop-cap"{% endif %}>{{ b.text | inline }}</p>{% endfor %}
{% if book.traits %}<div class="traits-title">Core {{ book.get('class_title') or book.title }} Traits</div>
<table class="traits-table"><tbody>{% for r in book.traits.rows if r.get('cells') %}<tr><th>{{ r.cells[0].html | safe }}</th><td>{{ r.cells[1].html | safe }}</td></tr>{% endfor %}</tbody></table>{% endif %}
</div>{% endif %}
</section>
{% for s in book.sections %}
{% if s.get('built') %}
<section class="class-sec" id="{{ s.sid }}">
<h2>{{ s.title }}</h2>
<div class="columns-1">{{ k.blocks(s.content) }}</div>
{{ k.table(s.built, "progression") }}
<div class="columns-2">{% for c in s.children %}{{ k.tree(c) }}{% endfor %}</div>
</section>
{% elif s.get('break') %}
{% if gallery_template is defined %}{% include gallery_template %}{% endif %}
{# a subclass booklet (--subclass) runs on under the opener, with no section title (after class features: a new page) #}
<section class="class-sec{% if not s.get('run_on') %} page-break{% endif %}" id="{{ s.sid }}">
{% if not s.get('hide_title') and s.title %}<h1>{{ s.title }}</h1>{% endif %}
{# a subclass whose art found no page of its own (break_before) starts a page, in new columns #}
<div class="columns-2">{{ k.blocks(s.content) }}{% for c in s.children %}{% if c.get("break_before") %}</div>
<div class="columns-2 page-break">{% endif %}{{ k.subclass(c) }}{% endfor %}</div>
</section>
{% else %}{# a subclass booklet's spell list and Character Options: headings across both columns (book.css) #}
<section class="class-sec{% if book.get('span_heads') %} span-head{% endif %}" id="{{ s.sid }}">
<div class="columns-2">{{ k.tree(s) }}</div>
</section>
{% endif %}
{% endfor %}
{% if book.spells %}{{ sp.spells(book.spells, brk=True) }}{% endif %}
{% endblock %}
